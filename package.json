{
  "name": "localix-grammar",
  "version": "1.0.0",
  "description": "AI-powered grammar, spelling, and style checker for Chrome. Works on any website.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "zip": "npm run build && mkdir -p dist-zip && cd dist && zip -r ../dist-zip/localix-grammar.zip . && echo 'Created dist-zip/localix-grammar.zip'"
  },
  "author": "Localix <hello@localix.ai> (https://localix.ai)",
  "license": "MIT",
  "homepage": "https://localix.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/localix/extension"
  },
  "keywords": [
    "grammar",
    "spelling",
    "ai",
    "chrome-extension",
    "localix",
    "openrouter"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
