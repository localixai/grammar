{
  "manifest_version": 3,
  "name": "Localix Grammar",
  "version": "1.0.0",
  "description": "AI-powered grammar, spelling, and style checker for Chrome. Works on any website.",
  "permissions": ["storage", "tabs", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icon-72x72.png",
      "32": "public/icon-96x96.png",
      "48": "public/icon-96x96.png",
      "128": "public/icon-128x128.png"
    }
  },
  "icons": {
    "16": "public/icon-72x72.png",
    "32": "public/icon-96x96.png",
    "48": "public/icon-96x96.png",
    "128": "public/icon-128x128.png",
    "192": "public/icon-192x192.png",
    "512": "public/icon-512x512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
